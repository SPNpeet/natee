{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natee",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/index.html",
      "/en.html",
      "/knowledge.html",
      "/knowledge-en.html",
      "/admin",
      "/admin/*",
      "/api/*",
      "/uploads/*",
      "/sitemap.xml",
      "/robots.txt",
      "/__shell.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "natee",
      "database_id": "REPLACE_WITH_CUSTOMER_D1_DATABASE_ID",
      "migrations_dir": "worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "REPLACE_WITH_CUSTOMER_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "SITE_URL": "https://REPLACE_WITH_CUSTOMER_DOMAIN"
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "account_id": "REPLACE_WITH_CUSTOMER_ACCOUNT_ID",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "REPLACE_WITH_CUSTOMER_DOMAIN",
      "custom_domain": true
    }
  ]
}
